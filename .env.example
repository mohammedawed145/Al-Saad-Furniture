# Copy this file to .env in the project root (or into /server) and fill in your values.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/al-saad-furniture

# JWT secret — use a long random string in production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Server port
PORT=5000

# Client origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Admin account (created or updated by `npm run reset-admin` in /server)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Production frontend URL; must be HTTPS in production
# CLIENT_ORIGIN=https://your-frontend.vercel.app

# Persistent image storage for production (recommended)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional site-wide contact fallbacks (also managed via branches in Admin)
SITE_PHONE=+201064990995
SITE_WHATSAPP=201064990995
SITE_EMAIL=asaadfurniture19@gmail.com
