# Copy this file to .env in the project root (or into /server) and fill in your values.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/al-saad-furniture

# JWT secret — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Server port
PORT=5000

# Client origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Seeded admin account (used only by `npm run seed` in /server)
ADMIN_EMAIL=asaadfurniture19@gmail.com
ADMIN_PASSWORD=change-this-password

# Optional site-wide contact fallbacks (also managed via branches in Admin)
SITE_PHONE=+201064990995
SITE_WHATSAPP=201064990995
SITE_EMAIL=asaadfurniture19@gmail.com
